# 🔐 متغيرات البيئة - Environment Variables Template

# ⚠️ تحذير أمان مهم:
# - لا تشارك هذا الملف مع أحد
# - لا تضيفه على GitHub أو أي مكان عام
# - احفظه في مكان آمن على الخادم فقط

# ==================================================
# 🤖 بيانات البوت - Telegram Bot Configuration
# ==================================================

# توكن البوت من @BotFather
# احصل عليه من: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# معرّف البوت (رقم)
# مثال: 123456789
TELEGRAM_BOT_ID=YOUR_BOT_ID_HERE

# ==================================================
# 👨‍💼 معرّفات المسؤولين - Admin IDs
# ==================================================

# معرّفات أو أسماء المستخدمين للمسؤولين
# فاصل بينهم بفاصلة
# مثال: 123456789,987654321,username1,username2
ADMIN_IDS=YOUR_ADMIN_ID_HERE

# ==================================================
# 💳 بيانات PayPal - PayPal Configuration
# ==================================================

# معرّف العميل (Client ID)
# احصل عليه من: https://developer.paypal.com
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID

# السر (Client Secret)
PAYPAL_SECRET=YOUR_PAYPAL_SECRET

# البيئة: sandbox أو production
# استخدم sandbox للاختبار
PAYPAL_ENV=sandbox

# رابط PayPal.me الخاص بك
# مثال: https://www.paypal.me/yourname
PAYPAL_ME_LINK=https://www.paypal.me/yourname

# ==================================================
# 🌐 بيانات قاعدة البيانات - Database (اختياري)
# ==================================================

# قاعدة البيانات (إذا كنت تستخدمها في المستقبل)
# DATABASE_URL=mysql://user:password@localhost/dbname

# ==================================================
# 📊 بيانات التحليلات - Analytics (اختياري)
# ==================================================

# مفتاح Google Analytics
# GOOGLE_ANALYTICS_KEY=YOUR_KEY_HERE

# ==================================================
# 🔧 إعدادات النظام - System Configuration
# ==================================================

# وضع التشغيل: production أو development
ENVIRONMENT=production

# رقم المنفذ (إذا كان مطلوباً)
PORT=8000

# ==================================================
# 📱 معلومات التواصل - Contact Information
# ==================================================

# رقم الدعم WhatsApp
WHATSAPP_SUPPORT=+20112030273

# اسم مستخدم Telegram للمطور
DEVELOPER_TELEGRAM=@Zi_ad_02

# البريد الإلكتروني للدعم
SUPPORT_EMAIL=support@example.com

# ==================================================
# 🔒 مفاتيح أمان إضافية - Security Keys (اختياري)
# ==================================================

# مفتاح تشفير للبيانات الحساسة
# SECRET_KEY=your-secret-key-here

# مفتاح JWT للمصادقة (إذا أضفت API)
# JWT_SECRET=your-jwt-secret-here

# ==================================================
# 🌍 بيانات أخرى - Additional Configuration
# ==================================================

# الدول المدعومة
SUPPORTED_COUNTRIES=Egypt,International

# العملات المدعومة
SUPPORTED_CURRENCIES=EGP,USD

# الحد الأقصى للأسئلة المجانية
FREE_QUESTIONS_LIMIT=5

# مدة الاشتراك الافتراضية (بالأيام)
DEFAULT_SUBSCRIPTION_DAYS=30
